{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:experience && next dev --turbopack",
    "build": "npm run build:experience && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "build:experience": "npm --prefix experience run build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app docs README.md package.json tsconfig.json vercel.json .github/workflows/build.yml",
    "format:check": "prettier --check app docs README.md package.json tsconfig.json vercel.json .github/workflows/build.yml",
    "watch:experience": "npm --prefix experience run watch"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "next": "15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
